# =============================================================================
#  Plantilla de variables. Uso:
#     cp .env.example .env
#     nano .env          # cambiar TODAS las claves "CAMBIAR..."
#
#  El archivo .env NUNCA se sube a Git (está en .gitignore).
#  Claves: solo letras, números y punto. Evitá $ ! comillas y espacios.
# =============================================================================

# --- Base de datos (MariaDB) -------------------------------------------------
DB_ROOT_PASSWORD=CAMBIARroot2026
DB_NAME=typo3
DB_USER=typo3
DB_PASSWORD=CAMBIARtypo3pass2026

# --- Administrador del backend de TYPO3 (https://.../typo3/) ------------------
# La clave debe cumplir la política de TYPO3: 8+ caracteres, con mayúscula,
# minúscula, número y un símbolo (el punto cuenta como símbolo).
TYPO3_ADMIN_USER=admin
TYPO3_ADMIN_PASSWORD=Pixel.Verde2026
TYPO3_ADMIN_EMAIL=admin@pixelverde.internal
TYPO3_PROJECT_NAME=Estudio Pixel Verde

# --- Sitio y dominio ----------------------------------------------------------
# URL base con la que TYPO3 crea el sitio en la primera instalación.
TYPO3_SITE_URL=https://pixelverde.internal/

# Dominios aceptados (expresión regular, sin ^ ni $).
TYPO3_TRUSTED_HOSTS=(pixelverde\.internal|localhost|127\.0\.0\.1|192\.168\.50\.1)(:[0-9]+)?

# Puerta de enlace de la red Docker = de dónde llegan las peticiones del proxy.
TYPO3_REVERSE_PROXY_IP=172.30.0.1

# Dejar VACÍO mientras se prueba por http://localhost:8080.
# Cuando el Integrante 2 tenga Apache con HTTPS como proxy: 172.30.0.1
TYPO3_REVERSE_PROXY_SSL=

# --- Publicación del puerto ---------------------------------------------------
# 127.0.0.1 = solo el propio servidor llega al contenedor (lo normal: Apache hace de proxy).
# Para una prueba rápida desde Mint sin proxy, poné 0.0.0.0 y entrá a http://192.168.50.1:8080
TYPO3_BIND_IP=127.0.0.1
TYPO3_HTTP_PORT=8080

# --- Opcionales ---------------------------------------------------------------
# Production oculta los errores al visitante; Development los muestra (para depurar).
TYPO3_CONTEXT=Production

# Tema de ejemplo que trae TYPO3 14 (lo decide el Integrante 3).
# Solo se aplica en la PRIMERA instalación. Vacío = sitio en blanco.
TYPO3_DISTRIBUTION=


# --- Bono: alta disponibilidad (docs/PASOS-bono.md) ---------------------------
# Para levantar la segunda copia de TYPO3 (typo3-2), quitar el # de la línea
# COMPOSE_FILE. Para apagar el bono: volver a poner el # y correr
#   docker compose up -d --remove-orphans
#COMPOSE_FILE=docker-compose.yml:docker-compose.ha.yml
TYPO3_HTTP_PORT_2=8081
